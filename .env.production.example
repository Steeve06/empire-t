# Production settings. Copy to .env.production on the server, fill in every value marked
# REQUIRED, and keep the file private (chmod 600). Never commit it.
# Used by infra/docker-compose.prod.yml and the scripts in infra/scripts/.

# --- Domain and HTTPS (REQUIRED) ---
DOMAIN=empire-t.cm
LETSENCRYPT_EMAIL=contact@empire-t.cm
# true while testing the setup (avoids Let's Encrypt rate limits), false for the real certificate
LETSENCRYPT_STAGING=false

# --- Database (REQUIRED: long random password, e.g. `openssl rand -base64 32`) ---
POSTGRES_DB=empire
POSTGRES_USER=empire
POSTGRES_PASSWORD=

# --- Django (REQUIRED) ---
# `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=
# The public domain, plus `api` (used by the pre-renderer inside Docker) and
# `127.0.0.1` (the container health check).
DJANGO_ALLOWED_HOSTS=empire-t.cm,www.empire-t.cm,api,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://empire-t.cm,https://www.empire-t.cm
# Same-origin site: the browser never calls the API cross-origin
CORS_ALLOWED_ORIGINS=
# Base for links to the admin in notification emails
ADMIN_URL_BASE=https://empire-t.cm
# Receive an email for every server error (comma-separated)
DJANGO_ADMINS_EMAILS=
LOG_LEVEL=INFO

# First admin account, created by `make prod-bootstrap`. Change the password after logging in.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=contact@empire-t.cm
DJANGO_SUPERUSER_PASSWORD=

# --- Email (REQUIRED for application and contact notifications) ---
# Replace with your SMTP server: smtp+tls://user:password@smtp-relay.brevo.com:587
# (consolemail:// only writes emails to the logs, nothing is delivered)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Empire T <no-reply@empire-t.cm>

# --- Uploaded files: local volume by default; optional S3-compatible storage ---
USE_S3=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_CUSTOM_DOMAIN=

# --- Performance ---
GUNICORN_WORKERS=3
# How often the static pages are re-rendered from the database, in seconds
PRERENDER_INTERVAL_SECONDS=3600

# --- Backups (infra/scripts/backup.sh) ---
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# rclone remote for an off-site copy, e.g. b2:empire-t-backups (leave empty to skip)
BACKUP_RCLONE_REMOTE=
