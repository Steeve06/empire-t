# Copy to .env at the repo root. docker compose reads it automatically.
# Never commit the real .env.

# --- Postgres (used by the db container and by the API) ---
POSTGRES_DB=empire
POSTGRES_USER=empire
POSTGRES_PASSWORD=change-me-locally

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgres://empire:change-me-locally@db:5432/empire
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Initial admin account created by `make superuser` / the compose bootstrap
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@empire-t.local
DJANGO_SUPERUSER_PASSWORD=change-me-locally

# --- Email (console backend in dev; SMTP in prod) ---
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Empire T <no-reply@empire-t.local>

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SITE_URL=http://localhost:5173
