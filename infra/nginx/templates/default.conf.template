# Production reverse proxy, rendered by the official nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only ${DOMAIN} is substituted.
#
#   /                 language redirect (/fr/ unless the browser prefers English)
#   /fr/..., /en/...  pre-rendered pages from the `site` volume (page.html, ADR-022)
#   /assets/          hashed build files, cached for a year
#   /api/, /admin/    gunicorn (Django); /static/ admin assets via WhiteNoise
#   /media/           uploaded photos from the shared `media` volume
# TLS terminates here with Let's Encrypt certificates (docs/deployment.md).

server_tokens off;

# Job applications: Django validates 15 MB per file and 40 MB in total
client_max_body_size 45m;
client_body_timeout 120s;

gzip on;
gzip_comp_level 5;
gzip_min_length 512;
gzip_vary on;
gzip_proxied any;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml application/manifest+json;

# Short edge cache for public API reads; Django already sends Cache-Control and
# includes the language in the URL (?lang=), so the URI is the whole key.
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_cache:10m max_size=100m inactive=10m use_temp_path=off;

upstream api_upstream {
  server api:8000;
  keepalive 16;
}

# English only when the browser lists English before any French
map $http_accept_language $preferred_lang {
  default fr;
  "~*^en(?!.*\bfr)" en;
}

server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://${DOMAIN}$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name www.${DOMAIN};
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  return 301 https://${DOMAIN}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  root /usr/share/nginx/html;
  include /etc/nginx/snippets/security-headers.conf;

  location = / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Vary "Accept-Language" always;
    add_header Cache-Control "no-cache" always;
    return 302 /$preferred_lang/;
  }

  # Hashed build assets never change: cache for a year
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location /media/ {
    alias /srv/media/;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=2592000" always;
  }

  location /api/ {
    include /etc/nginx/snippets/proxy-to-api.conf;
    proxy_read_timeout 120s;
    proxy_cache api_cache;
    proxy_cache_methods GET HEAD;
    proxy_cache_key "$scheme$request_method$host$request_uri";
    proxy_cache_bypass $http_authorization $cookie_sessionid;
    proxy_no_cache $http_authorization $cookie_sessionid;
  }

  location /admin/ {
    include /etc/nginx/snippets/proxy-to-api.conf;
    include /etc/nginx/snippets/security-headers-admin.conf;
    proxy_read_timeout 120s;
  }

  location /static/ {
    include /etc/nginx/snippets/proxy-to-api.conf;
  }

  location /en/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=300, stale-while-revalidate=86400" always;
    try_files $uri $uri.html $uri/index.html =404;
    error_page 404 /en/404.html;
  }

  # French pages and root files (sitemap.xml, robots.txt, favicon...)
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=300, stale-while-revalidate=86400" always;
    try_files $uri $uri.html $uri/index.html =404;
  }

  error_page 404 /404.html;
  error_page 500 502 503 504 /500.html;
  location = /404.html {
    internal;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location = /en/404.html {
    internal;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location = /500.html {
    internal;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
}
