# Production reverse proxy, rendered by the official nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only ${DOMAIN} is substituted.
# TLS terminates here; certificates come from certbot (see docs/deployment.md).
# - Pre-rendered frontend served as static files, hashed assets cached for a year
# - /api/ and /admin/ proxied to gunicorn
# - /static/ (Django admin assets) and /media/ served from shared volumes

server_tokens off;

# Uploads: application files are validated by Django (15 MB each, 40 MB total)
client_max_body_size 45m;
client_body_timeout 120s;

gzip on;
gzip_comp_level 5;
gzip_min_length 512;
gzip_vary on;
gzip_proxied any;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml application/manifest+json;

# Small edge cache for public API reads (Django already sends Cache-Control)
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_cache:10m max_size=100m inactive=10m use_temp_path=off;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream api_upstream {
  server api:8000;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; base-uri 'self'; form-action 'self' https://wa.me; frame-ancestors 'none'" always;

  root /usr/share/nginx/html;

  # Hashed build assets: cache for a year
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location /static/ {
    alias /srv/static/;
    expires 30d;
    add_header Cache-Control "public";
  }

  location /media/ {
    alias /srv/media/;
    expires 30d;
    add_header Cache-Control "public";
  }

  location /api/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    proxy_cache api_cache;
    proxy_cache_methods GET HEAD;
    proxy_cache_key "$scheme$request_method$host$request_uri$http_accept_language";
    proxy_cache_bypass $http_authorization $cookie_sessionid;
    proxy_no_cache $http_authorization $cookie_sessionid;
    add_header X-Cache-Status $upstream_cache_status always;
  }

  location /admin/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # Pre-rendered pages: /fr/services/ -> /fr/services/index.html
  location / {
    add_header Cache-Control "public, max-age=300, stale-while-revalidate=86400";
    try_files $uri $uri/index.html $uri.html /404.html =404;
  }

  error_page 404 /404.html;
  error_page 500 502 503 504 /500.html;
  location = /404.html { internal; }
  location = /500.html { internal; }
}
